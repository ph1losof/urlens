{
  "name": "urlens",
  "version": "0.6.0",
  "description": "Zero-allocation URL slicing — 5-73x faster than the native URL parser. Read, write, and predicate functions that compare bytes in place without allocating.",
  "keywords": [
    "url",
    "query-string",
    "pathname",
    "origin",
    "fast",
    "zero-allocation"
  ],
  "homepage": "https://github.com/ph1losof/urlens#readme",
  "bugs": {
    "url": "https://github.com/ph1losof/urlens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ph1losof/urlens.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "bench": "bun bench/driver.ts",
    "bench:micro": "URLENS_BENCH_FILTER=micro. bun bench/driver.ts",
    "bench:update-readme": "bun bench/driver.ts 2>&1 | tee bench-output.txt && bun scripts/update-readme-bench.ts bench-output.txt && rm bench-output.txt",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "check": "biome check . && bun run typecheck",
    "ci": "bun run check && bun run test:coverage && bun run pack:check",
    "clean": "bun -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepack": "bun run build",
    "pack:check": "bun run build && npm pack --dry-run --ignore-scripts",
    "test": "bun test && bun scripts/check-coverage.ts",
    "test:coverage": "bun test --coverage && bun scripts/check-coverage.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
